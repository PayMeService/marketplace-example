# Copy to .env and edit as needed.

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Public base URL of the API, as PayMe's SERVERS will reach it. Callback URLs
# are built from this.
# PayMe refuses callback URLs pointing at "localhost", so for callbacks to
# actually arrive in local dev you need a public tunnel:
#   cloudflared tunnel --url http://localhost:3000
#   ngrok http 3000
# Then set PUBLIC_BASE_URL to the tunnel URL. While it stays on localhost the
# backend omits sale_callback_url/sub_callback_url from PayMe requests and you
# can exercise the handlers with the local callback simulator instead
# (see docs/07-callbacks-and-signatures.md).
PUBLIC_BASE_URL=http://localhost:3000
# Public base URL of the browser APP. Buyer-facing return URLs
# (sale_return_url, sub_return_url) are built from this. Different from
# PUBLIC_BASE_URL in dev, where Vite and the API are on separate ports; the same
# in production, where nginx serves the SPA and proxies /api on one origin.
# This one MAY be localhost — the buyer's own browser follows it, not PayMe.
PUBLIC_APP_URL=http://localhost:5173

# JWT signing secret for this demo app's own user sessions (not PayMe related).
JWT_SECRET=change-me-in-any-real-deployment
JWT_EXPIRES_IN=12h

# --- PayMe ---
# Environment: sandbox -> https://sandbox.payme.io/api/ | production -> https://live.payme.io/api/
PAYME_ENV=sandbox

# Partner credentials. PAYME_CLIENT_KEY is the "Partner Key" from your PayMe
# account; it authenticates partner-level calls (create-seller, get-sellers,
# refund-sale, ...). PAYME_CLIENT_SECRET is the partner secret used ONLY to
# verify the md5 `payme_signature` on incoming callbacks — it is never sent to
# PayMe. Both are editable at runtime from the app's Settings page, which
# overrides these values; these are the seed/bootstrap values.
PAYME_CLIENT_KEY=
PAYME_CLIENT_SECRET=

# Your marketplace's own MPL (the "API identifier" PayMe issued you). Used for
# partner-scoped calls such as POST /api/sellers/{mpl}/tokens.
PAYME_MARKETPLACE_MPL=

# Seed admin account created on first boot.
ADMIN_EMAIL=admin@marketplace.test
ADMIN_PASSWORD=admin1234

# --- Postgres ---
DB_HOST=postgres
DB_PORT=5432
# Host-side port mapping (change if 5432 is already in use locally — e.g. 5433)
DB_HOST_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=marketplace-example
# Auto-create schema from entities (dev only — use migrations in prod)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Compose host-side port overrides ---
# Dev — host ports for the dev stack. Bump these if you have collisions.
BACKEND_HOST_PORT=3000
BACKEND_DEBUG_HOST_PORT=9229
FRONTEND_HOST_PORT=5173
# Prod
FRONTEND_PORT=8080
ADMINER_PORT=8081

# --- Frontend (build-time) ---
VITE_API_URL=/api
